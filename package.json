{
  "name": "droplet",
  "version": "0.1.0",
  "private": true,
  "description": "eBay Stock Inventory System",
  "main": "dist/index.js",
  "repository": "https://github.com/vylpes/droplet.git",
  "author": "Ethan Lane <ethan@vylpes.com>",
  "license": "MIT",
  "funding": "https://ko-fi.com/vylpes",
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "clean": "rm -rf node_modules/ dist/ frontend/dist frontend/node_modules shared/dist shared/node_modules",
    "build": "yarn build:shared && tsc && yarn build:frontend",
    "build:shared": "yarn workspace @droplet/shared build",
    "build:frontend": "yarn workspace @droplet/frontend build",
    "dev:frontend": "yarn workspace @droplet/frontend dev",
    "start": "node dist/index.js",
    "init": "node dist/init.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest && yarn test:frontend",
    "test:backend": "jest",
    "test:frontend": "yarn workspace @droplet/frontend test",
    "db:up": "typeorm migration:run -d ./dist/database/dataSources/appDataSource.js",
    "db:down": "typeorm migration:revert -d dist/database/dataSources/appDataSource.js",
    "db:create": "typeorm migration:create ./src/database/migrations",
    "release": "np --no-publish"
  },
  "dependencies": {
    "@droplet/shared": "*",
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^11.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "core-js": "^3.50.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.0",
    "reflection": "^0.0.1",
    "tsyringe": "^4.10.0",
    "typeorm": "^1.1.1",
    "typeorm-store": "^2.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.1",
    "np": "^12.1.1",
    "ts-jest": "^29.4.13",
    "ts-mockito": "^2.6.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "resolutions": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.0.0",
    "@babel/core": "7.29.7",
    "@babel/helpers": "7.29.7",
    "browserslist": "4.29.1",
    "cross-spawn": "7.0.6",
    "js-yaml": "3.15.2",
    "lodash": "4.18.1",
    "test-exclude": "8.0.0",
    "anymatch/picomatch": "2.3.2"
  }
}
